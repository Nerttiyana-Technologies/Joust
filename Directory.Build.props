<Project>

  <!-- Shared properties for every project in the Joust solution. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Don't fail the build on missing XML doc comments. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <Authors>Nerttiyana Technologies</Authors>
    <Product>Joust</Product>
    <Company>Nerttiyana Technologies</Company>
    <Copyright>Copyright (c) Nerttiyana Technologies</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <Version>1.0.0</Version>

    <PackageProjectUrl>https://github.com/Nerttiyana-Technologies/Joust</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Nerttiyana-Technologies/Joust.git</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageTags>lancedb;vector-database;vector-search;linq;embeddings;ai;rag;semantic-kernel;arrow</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

</Project>
